  },
  "license": "LGPL-3.0",
  "icon": "assets/xtremeutilities/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.xtremeutilities.XtremeUtilitiesClient"
    ]
  },
  "mixins": [
    "xtremeutilities.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
